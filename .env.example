# Notionの内部インテグレーショントークン（このファイルを.env.localへコピーして設定）
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxx

# NotionのデータベースURLをそのまま貼れます（またはDatabase ID）
NOTION_DATABASE_ID=https://www.notion.so/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx?v=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 複数データソースを使う場合だけ明示（通常は空欄でOK）
NOTION_DATA_SOURCE_ID=

# 使用するOllamaモデル
OLLAMA_MODEL=gemma3:4b
OLLAMA_URL=http://127.0.0.1:11434

# Notion列名（必要なら変更）
NOTION_WORD_PROPERTY=用語
NOTION_CONTEXT_PROPERTY=文脈
NOTION_RESULT_PROPERTY=解説
NOTION_STATUS_PROPERTY=状態
NOTION_MODEL_PROPERTY=使用モデル

# 常駐時の確認間隔（ミリ秒）
POLL_INTERVAL_MS=5000
